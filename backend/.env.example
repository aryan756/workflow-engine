# Copy to backend/.env and edit as needed. Every value has a working default.

# --- storage ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./agentic_workflow.db

# --- agent provider --------------------------------------------------------
# auto   -> Claude when ANTHROPIC_API_KEY is set, otherwise the deterministic mock
# mock   -> always the rule-based provider (no network, fully reproducible)
# claude -> always Claude
AGENT_PROVIDER=auto

# Set this to run agent/decision nodes against the real Claude API.
# ANTHROPIC_API_KEY=sk-ant-...

ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=4096
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low

# --- debugging -------------------------------------------------------------
# `options.faults` on a run lets any caller force node failures. That is the
# point of the debugger, but it should be off outside a demo environment.
# When false the server silently drops `faults` and the UI hides the control.
ENABLE_FAULT_INJECTION=true

# --- http ------------------------------------------------------------------
# CORS_ORIGINS=["http://localhost:5173"]
